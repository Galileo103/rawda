  "title": { "ar": "نَكْتَشِفُ أَفْكَارًا جَدِيدَةً", "en": "Discover new ideas" },
  "intro": { "ar": "هَيَّا نَتَعَلَّمُ كَيْفَ نُفَكِّرُ وَنَحُلُّ الْأَلْغَازَ!", "en": "Let's learn how to think and solve puzzles!" },
  "items": [
    { "id": "odd", "skill": "logic.odd", "difficulty": 1, "teaches": ["logic.odd"], "say": { "ar": "هَيَّا نَتَعَلَّمُ فِكْرَةً جَدِيدَةً!", "en": "Let's learn a new idea!" }, "focus": { "kind": "row", "items": [ { "kind": "lex", "id": "cat" }, { "kind": "lex", "id": "dog" }, { "kind": "lex", "id": "rabbit" }, { "kind": "lex", "id": "apple" } ], "question": false }, "meet": { "ar": "هُنَا ثَلَاثَةُ حَيَوَانَاتٍ وَتُفَّاحَةٌ؛ التُّفَّاحَةُ لَا تُشْبِهُ الْبَاقِيَ!", "en": "Here are three animals and an apple. The apple doesn't belong!" }, "check": { "say": { "ar": "أَيُّ صُورَةٍ لَا تُشْبِهُ الْبَاقِيَ؟", "en": "Which picture doesn't belong?" }, "answer": { "kind": "lex", "id": "apple" }, "choices": [ { "kind": "lex", "id": "apple" }, { "kind": "lex", "id": "dog" } ], "show": { "kind": "row", "items": [ { "kind": "lex", "id": "cat" }, { "kind": "lex", "id": "apple" }, { "kind": "lex", "id": "dog" }, { "kind": "lex", "id": "rabbit" } ], "question": false } } },
    { "id": "pattern-ab", "skill": "logic.pattern.ab", "difficulty": 1, "teaches": ["logic.pattern.ab"], "say": { "ar": "هَيَّا نَتَعَلَّمُ فِكْرَةً جَدِيدَةً!", "en": "Let's learn a new idea!" }, "focus": { "kind": "row", "items": [ { "kind": "color", "color": "red" }, { "kind": "color", "color": "blue" }, { "kind": "color", "color": "red" }, { "kind": "color", "color": "blue" } ], "question": false }, "meet": { "ar": "أَحْمَرُ، أَزْرَقُ، أَحْمَرُ، أَزْرَقُ… هَذَا نَمَطٌ يَتَكَرَّرُ!", "en": "Red, blue, red, blue… this is a pattern that repeats!" }, "check": { "say": { "ar": "أَحْمَرُ، أَزْرَقُ، أَحْمَرُ… مَا الَّذِي يَأْتِي بَعْدَهُ؟", "en": "Red, blue, red… what comes next?" }, "answer": { "kind": "color", "color": "blue" }, "choices": [ { "kind": "color", "color": "blue" }, { "kind": "color", "color": "yellow" } ], "show": { "kind": "row", "items": [ { "kind": "color", "color": "red" }, { "kind": "color", "color": "blue" }, { "kind": "color", "color": "red" } ], "question": true } } },
    { "id": "pattern-abb", "skill": "logic.pattern.abb", "difficulty": 1, "teaches": ["logic.pattern.abb"], "say": { "ar": "هَيَّا نَتَعَلَّمُ فِكْرَةً جَدِيدَةً!", "en": "Let's learn a new idea!" }, "focus": { "kind": "row", "items": [ { "kind": "shape", "shape": "star" }, { "kind": "shape", "shape": "heart" }, { "kind": "shape", "shape": "heart" }, { "kind": "shape", "shape": "star" }, { "kind": "shape", "shape": "heart" }, { "kind": "shape", "shape": "heart" } ], "question": false }, "meet": { "ar": "نَجْمَةٌ، قَلْبٌ، قَلْبٌ… ثُمَّ نَبْدَأُ مِنْ جَدِيدٍ؛ هَكَذَا يَتَكَرَّرُ النَّمَطُ.", "en": "Star, heart, heart… then we start again. That is how the pattern repeats." }, "check": { "say": { "ar": "نَجْمَةٌ، قَلْبٌ، قَلْبٌ… مَا الَّذِي يَأْتِي بَعْدَ ذَلِكَ؟", "en": "Star, heart, heart… what comes next?" }, "answer": { "kind": "shape", "shape": "star" }, "choices": [ { "kind": "shape", "shape": "star" }, { "kind": "shape", "shape": "heart" } ], "show": { "kind": "row", "items": [ { "kind": "shape", "shape": "star" }, { "kind": "shape", "shape": "heart" }, { "kind": "shape", "shape": "heart" }, { "kind": "shape", "shape": "star" }, { "kind": "shape", "shape": "heart" }, { "kind": "shape", "shape": "heart" } ], "question": true } } },
    { "id": "sort-color", "skill": "logic.sort.color", "difficulty": 1, "teaches": ["logic.sort.color"], "say": { "ar": "هَيَّا نَتَعَلَّمُ فِكْرَةً جَدِيدَةً!", "en": "Let's learn a new idea!" }, "focus": { "kind": "row", "items": [ { "kind": "lex", "id": "apple" }, { "kind": "lex", "id": "strawberry" }, { "kind": "lex", "id": "banana" }, { "kind": "lex", "id": "lemon" } ], "question": false }, "meet": { "ar": "نَجْمَعُ الْأَشْيَاءَ الْحَمْرَاءَ مَعًا، وَالْأَشْيَاءَ الصَّفْرَاءَ مَعًا.", "en": "We put the red things together and the yellow things together." }, "check": { "say": { "ar": "أَيُّهُمَا لَوْنُهُ مِثْلُ التُّفَّاحَةِ؟", "en": "Which one is the same color as the apple?" }, "answer": { "kind": "lex", "id": "strawberry" }, "choices": [ { "kind": "lex", "id": "strawberry" }, { "kind": "lex", "id": "banana" } ] } },
    { "id": "sort-shape", "skill": "logic.sort.shape", "difficulty": 1, "teaches": ["logic.sort.shape"], "say": { "ar": "هَيَّا نَتَعَلَّمُ فِكْرَةً جَدِيدَةً!", "en": "Let's learn a new idea!" }, "focus": { "kind": "row", "items": [ { "kind": "shape", "shape": "circle" }, { "kind": "shape", "shape": "circle" }, { "kind": "shape", "shape": "triangle" }, { "kind": "shape", "shape": "triangle" } ], "question": false }, "meet": { "ar": "الدَّوَائِرُ مَعًا، وَالْمُثَلَّثَاتُ مَعًا!", "en": "Circles go together, and triangles go together!" }, "check": { "say": { "ar": "أَيُّهُمَا يَذْهَبُ مَعَ الدَّوَائِرِ؟", "en": "Which one goes with the circles?" }, "answer": { "kind": "shape", "shape": "circle" }, "choices": [ { "kind": "shape", "shape": "circle" }, { "kind": "shape", "shape": "triangle" } ] } },
    { "id": "sort-place", "skill": "logic.sort.place", "difficulty": 1, "teaches": ["logic.sort.place"], "say": { "ar": "هَيَّا نَتَعَلَّمُ فِكْرَةً جَدِيدَةً!", "en": "Let's learn a new idea!" }, "focus": { "kind": "row", "items": [ { "kind": "lex", "id": "bird" }, { "kind": "lex", "id": "airplane" }, { "kind": "lex", "id": "fish" }, { "kind": "lex", "id": "whale" } ], "question": false }, "meet": { "ar": "الطَّائِرُ وَالطَّائِرَةُ فِي السَّمَاءِ، وَالسَّمَكَةُ وَالْحُوتُ فِي الْبَحْرِ.", "en": "The bird and the airplane are in the sky; the fish and the whale are in the sea." }, "check": { "say": { "ar": "أَيُّهُمَا يَسْبَحُ فِي الْبَحْرِ؟", "en": "Which one swims in the sea?" }, "answer": { "kind": "lex", "id": "fish" }, "choices": [ { "kind": "lex", "id": "fish" }, { "kind": "lex", "id": "airplane" } ] } },
    { "id": "sort-home", "skill": "logic.sort.habitat", "difficulty": 1, "teaches": ["logic.sort.habitat"], "say": { "ar": "هَيَّا نَتَعَلَّمُ فِكْرَةً جَدِيدَةً!", "en": "Let's learn a new idea!" }, "focus": { "kind": "row", "items": [ { "kind": "lex", "id": "lion" }, { "kind": "lex", "id": "cow" }, { "kind": "lex", "id": "fish" }, { "kind": "lex", "id": "jellyfish" } ], "question": false }, "meet": { "ar": "الْأَسَدُ وَالْبَقَرَةُ يَعِيشَانِ عَلَى الْأَرْضِ، وَالسَّمَكَةُ وَقِنْدِيلُ الْبَحْرِ فِي الْمَاءِ.", "en": "The lion and the cow live on land; the fish and the jellyfish live in the water." }, "check": { "say": { "ar": "مَنْ يَعِيشُ فِي الْبَحْرِ؟", "en": "Who lives in the sea?" }, "answer": { "kind": "lex", "id": "jellyfish" }, "choices": [ { "kind": "lex", "id": "jellyfish" }, { "kind": "lex", "id": "lion" } ] } },
    { "id": "sort-weather", "skill": "logic.sort.weather", "difficulty": 1, "teaches": ["logic.sort.weather"], "say": { "ar": "هَيَّا نَتَعَلَّمُ فِكْرَةً جَدِيدَةً!", "en": "Let's learn a new idea!" }, "focus": { "kind": "row", "items": [ { "kind": "lex", "id": "sunglasses" }, { "kind": "lex", "id": "tshirt" }, { "kind": "lex", "id": "coat" }, { "kind": "lex", "id": "scarf" } ], "question": false }, "meet": { "ar": "لِلشَّمْسِ مَلَابِسُ خَفِيفَةٌ، وَلِلْبَرْدِ مَلَابِسُ دَافِئَةٌ.", "en": "Light clothes are for sunny days, warm clothes are for the cold." }, "check": { "say": { "ar": "مَاذَا نَلْبَسُ فِي الْبَرْدِ؟", "en": "What do we wear in the cold?" }, "answer": { "kind": "lex", "id": "coat" }, "choices": [ { "kind": "lex", "id": "coat" }, { "kind": "lex", "id": "sunglasses" } ] } },
    { "id": "memory", "skill": "logic.memory.2", "difficulty": 1, "teaches": ["logic.memory.2", "logic.memory.3", "logic.memory.4", "logic.memory.5", "logic.memory.6"], "say": { "ar": "هَيَّا نَتَعَلَّمُ فِكْرَةً جَدِيدَةً!", "en": "Let's learn a new idea!" }, "focus": { "kind": "row", "items": [ { "kind": "lex", "id": "cat" }, { "kind": "lex", "id": "dog" }, { "kind": "lex", "id": "cat" }, { "kind": "lex", "id": "dog" } ], "question": false }, "meet": { "ar": "فِي لُعْبَةِ الذَّاكِرَةِ نَبْحَثُ عَنْ صُورَتَيْنِ مُتَشَابِهَتَيْنِ، وَنَتَذَكَّرُ مَكَانَهُمَا.", "en": "In the memory game we look for two pictures that match, and remember where they are." }, "check": { "say": { "ar": "أَيُّ صُورَةٍ تُشْبِهُ الْقِطَّةَ؟", "en": "Which picture matches the cat?" }, "answer": { "kind": "lex", "id": "cat" }, "choices": [ { "kind": "lex", "id": "cat" }, { "kind": "lex", "id": "dog" } ] } }
  ]
}
