  "items": [
    { "id": "bismillah", "skill": "islam.phrase.bismillah", "difficulty": 1, "teaches": ["islam.phrase.bismillah"], "say": { "ar": "هَيَّا نَتَعَلَّمُ كَلِمَةً طَيِّبَةً!", "en": "Let's learn a kind word!" }, "focus": { "kind": "phrase", "text": { "ar": "بِسْمِ اللهِ", "en": "Bismillah" } }, "meet": { "ar": "نَقُولُ «بِسْمِ اللهِ» قَبْلَ أَنْ نَأْكُلَ، وَقَبْلَ أَنْ نَبْدَأَ أَيَّ عَمَلٍ.", "en": "We say \"Bismillah\" before we eat and before we start anything." }, "examples": ["meal"], "check": { "say": { "ar": "مَاذَا نَقُولُ قَبْلَ أَنْ نَأْكُلَ؟", "en": "What do we say before we eat?" }, "answer": { "kind": "phrase", "text": { "ar": "بِسْمِ اللهِ", "en": "Bismillah" } }, "choices": [ { "kind": "phrase", "text": { "ar": "بِسْمِ اللهِ", "en": "Bismillah" } }, { "kind": "phrase", "text": { "ar": "السَّلَامُ عَلَيْكُمْ", "en": "Assalamu alaykum" } } ] } },
    { "id": "alhamdulillah", "skill": "islam.phrase.alhamdulillah", "difficulty": 1, "teaches": ["islam.phrase.alhamdulillah"], "say": { "ar": "هَيَّا نَتَعَلَّمُ كَلِمَةً طَيِّبَةً!", "en": "Let's learn a kind word!" }, "focus": { "kind": "phrase", "text": { "ar": "الْحَمْدُ لِلَّهِ", "en": "Alhamdulillah" } }, "meet": { "ar": "نَقُولُ «الْحَمْدُ لِلَّهِ» بَعْدَ أَنْ نَأْكُلَ؛ نَشْكُرُ اللهَ عَلَى الطَّعَامِ.", "en": "We say \"Alhamdulillah\" after we eat, to thank Allah for our food." }, "examples": ["meal"], "check": { "say": { "ar": "مَاذَا نَقُولُ بَعْدَ أَنْ نَأْكُلَ؟", "en": "What do we say after we eat?" }, "answer": { "kind": "phrase", "text": { "ar": "الْحَمْدُ لِلَّهِ", "en": "Alhamdulillah" } }, "choices": [ { "kind": "phrase", "text": { "ar": "الْحَمْدُ لِلَّهِ", "en": "Alhamdulillah" } }, { "kind": "phrase", "text": { "ar": "بِسْمِ اللهِ", "en": "Bismillah" } } ] } },
    { "id": "salam", "skill": "islam.phrase.salam", "difficulty": 1, "teaches": ["islam.phrase.salam"], "say": { "ar": "هَيَّا نَتَعَلَّمُ كَلِمَةً طَيِّبَةً!", "en": "Let's learn a kind word!" }, "focus": { "kind": "phrase", "text": { "ar": "السَّلَامُ عَلَيْكُمْ", "en": "Assalamu alaykum" } }, "meet": { "ar": "عِنْدَمَا نُقَابِلُ أَصْدِقَاءَنَا نَقُولُ «السَّلَامُ عَلَيْكُمْ».", "en": "When we meet our friends we say \"Assalamu alaykum\"." }, "examples": ["wave"], "check": { "say": { "ar": "مَاذَا نَقُولُ عِنْدَمَا نُقَابِلُ أَصْدِقَاءَنَا؟", "en": "What do we say when we meet our friends?" }, "answer": { "kind": "phrase", "text": { "ar": "السَّلَامُ عَلَيْكُمْ", "en": "Assalamu alaykum" } }, "choices": [ { "kind": "phrase", "text": { "ar": "السَّلَامُ عَلَيْكُمْ", "en": "Assalamu alaykum" } }, { "kind": "phrase", "text": { "ar": "الْحَمْدُ لِلَّهِ", "en": "Alhamdulillah" } } ] } },
    { "id": "sneeze", "skill": "islam.phrase.sneeze", "difficulty": 1, "teaches": ["islam.phrase.sneeze"], "say": { "ar": "هَيَّا نَتَعَلَّمُ كَلِمَةً طَيِّبَةً!", "en": "Let's learn a kind word!" }, "focus": { "kind": "phrase", "text": { "ar": "الْحَمْدُ لِلَّهِ", "en": "Alhamdulillah" } }, "meet": { "ar": "عِنْدَمَا نَعْطِسُ نَقُولُ «الْحَمْدُ لِلَّهِ».", "en": "When we sneeze we say \"Alhamdulillah\"." }, "examples": ["sneeze"], "check": { "say": { "ar": "مَاذَا نَقُولُ عِنْدَمَا نَعْطِسُ؟", "en": "What do we say when we sneeze?" }, "answer": { "kind": "phrase", "text": { "ar": "الْحَمْدُ لِلَّهِ", "en": "Alhamdulillah" } }, "choices": [ { "kind": "phrase", "text": { "ar": "الْحَمْدُ لِلَّهِ", "en": "Alhamdulillah" } }, { "kind": "phrase", "text": { "ar": "السَّلَامُ عَلَيْكُمْ", "en": "Assalamu alaykum" } } ] } },
    { "id": "creation-sun", "skill": "islam.creation.sun", "difficulty": 1, "teaches": ["islam.creation.sun"], "say": { "ar": "هَيَّا نَتَعَرَّفُ عَلَى شَيْءٍ خَلَقَهُ اللهُ!", "en": "Let's meet something Allah created!" }, "focus": { "kind": "lex", "id": "sun" }, "meet": { "ar": "خَلَقَ اللهُ الشَّمْسَ؛ تُضِيءُ لَنَا النَّهَارَ وَتُدَفِّئُنَا.", "en": "Allah created the sun. It lights up the day and keeps us warm." }, "check": { "say": { "ar": "أَيْنَ الشَّمْسُ؟", "en": "Where is the sun?" }, "answer": { "kind": "lex", "id": "sun" }, "choices": [ { "kind": "lex", "id": "sun" }, { "kind": "lex", "id": "tree" } ] } },
    { "id": "creation-moon", "skill": "islam.creation.moon", "difficulty": 1, "teaches": ["islam.creation.moon"], "say": { "ar": "هَيَّا نَتَعَرَّفُ عَلَى شَيْءٍ خَلَقَهُ اللهُ!", "en": "Let's meet something Allah created!" }, "focus": { "kind": "lex", "id": "crescent" }, "meet": { "ar": "خَلَقَ اللهُ الْقَمَرَ؛ نَرَاهُ هِلَالًا فِي سَمَاءِ اللَّيْلِ.", "en": "Allah created the moon. We see it as a crescent in the night sky." }, "check": { "say": { "ar": "أَيْنَ الْهِلَالُ؟", "en": "Where is the crescent moon?" }, "answer": { "kind": "lex", "id": "crescent" }, "choices": [ { "kind": "lex", "id": "crescent" }, { "kind": "lex", "id": "sun" } ] } },
    { "id": "creation-star", "skill": "islam.creation.star", "difficulty": 1, "teaches": ["islam.creation.star"], "say": { "ar": "هَيَّا نَتَعَرَّفُ عَلَى شَيْءٍ خَلَقَهُ اللهُ!", "en": "Let's meet something Allah created!" }, "focus": { "kind": "lex", "id": "star" }, "meet": { "ar": "خَلَقَ اللهُ النُّجُومَ؛ تَلْمَعُ فِي السَّمَاءِ لَيْلًا.", "en": "Allah created the stars. They twinkle in the sky at night." }, "check": { "say": { "ar": "أَيْنَ النَّجْمَةُ؟", "en": "Where is the star?" }, "answer": { "kind": "lex", "id": "star" }, "choices": [ { "kind": "lex", "id": "star" }, { "kind": "lex", "id": "fish" } ] } },
    { "id": "creation-tree", "skill": "islam.creation.tree", "difficulty": 1, "teaches": ["islam.creation.tree"], "say": { "ar": "هَيَّا نَتَعَرَّفُ عَلَى شَيْءٍ خَلَقَهُ اللهُ!", "en": "Let's meet something Allah created!" }, "focus": { "kind": "lex", "id": "tree" }, "meet": { "ar": "خَلَقَ اللهُ الشَّجَرَةَ؛ تُعْطِينَا الظِّلَّ وَالثِّمَارَ.", "en": "Allah created trees. They give us shade and fruit." }, "check": { "say": { "ar": "أَيْنَ الشَّجَرَةُ؟", "en": "Where is the tree?" }, "answer": { "kind": "lex", "id": "tree" }, "choices": [ { "kind": "lex", "id": "tree" }, { "kind": "lex", "id": "sea" } ] } },
    { "id": "creation-flower", "skill": "islam.creation.flower", "difficulty": 1, "teaches": ["islam.creation.flower"], "say": { "ar": "هَيَّا نَتَعَرَّفُ عَلَى شَيْءٍ خَلَقَهُ اللهُ!", "en": "Let's meet something Allah created!" }, "focus": { "kind": "lex", "id": "flower" }, "meet": { "ar": "خَلَقَ اللهُ الزُّهُورَ؛ جَمِيلَةٌ وَرَائِحَتُهَا طَيِّبَةٌ.", "en": "Allah created flowers. They are beautiful and smell lovely." }, "check": { "say": { "ar": "أَيْنَ الزَّهْرَةُ؟", "en": "Where is the flower?" }, "answer": { "kind": "lex", "id": "flower" }, "choices": [ { "kind": "lex", "id": "flower" }, { "kind": "lex", "id": "star" } ] } },
    { "id": "creation-fish", "skill": "islam.creation.fish", "difficulty": 1, "teaches": ["islam.creation.fish"], "say": { "ar": "هَيَّا نَتَعَرَّفُ عَلَى شَيْءٍ خَلَقَهُ اللهُ!", "en": "Let's meet something Allah created!" }, "focus": { "kind": "lex", "id": "fish" }, "meet": { "ar": "خَلَقَ اللهُ السَّمَكَ؛ يَسْبَحُ فِي الْمَاءِ.", "en": "Allah created fish. They swim in the water." }, "check": { "say": { "ar": "أَيْنَ السَّمَكَةُ؟", "en": "Where is the fish?" }, "answer": { "kind": "lex", "id": "fish" }, "choices": [ { "kind": "lex", "id": "fish" }, { "kind": "lex", "id": "butterfly" } ] } },
    { "id": "creation-butterfly", "skill": "islam.creation.butterfly", "difficulty": 1, "teaches": ["islam.creation.butterfly"], "say": { "ar": "هَيَّا نَتَعَرَّفُ عَلَى شَيْءٍ خَلَقَهُ اللهُ!", "en": "Let's meet something Allah created!" }, "focus": { "kind": "lex", "id": "butterfly" }, "meet": { "ar": "خَلَقَ اللهُ الْفَرَاشَةَ بِأَلْوَانٍ جَمِيلَةٍ.", "en": "Allah created the butterfly with beautiful colors." }, "check": { "say": { "ar": "أَيْنَ الْفَرَاشَةُ؟", "en": "Where is the butterfly?" }, "answer": { "kind": "lex", "id": "butterfly" }, "choices": [ { "kind": "lex", "id": "butterfly" }, { "kind": "lex", "id": "flower" } ] } },
    { "id": "creation-sea", "skill": "islam.creation.sea", "difficulty": 1, "teaches": ["islam.creation.sea"], "say": { "ar": "هَيَّا نَتَعَرَّفُ عَلَى شَيْءٍ خَلَقَهُ اللهُ!", "en": "Let's meet something Allah created!" }, "focus": { "kind": "lex", "id": "sea" }, "meet": { "ar": "خَلَقَ اللهُ الْبَحْرَ الْكَبِيرَ؛ تَعِيشُ فِيهِ الْأَسْمَاكُ.", "en": "Allah created the big sea. Fish live in it." }, "check": { "say": { "ar": "أَيْنَ الْبَحْرُ؟", "en": "Where is the sea?" }, "answer": { "kind": "lex", "id": "sea" }, "choices": [ { "kind": "lex", "id": "sea" }, { "kind": "lex", "id": "rainbow" } ] } },
    { "id": "creation-rainbow", "skill": "islam.creation.rainbow", "difficulty": 1, "teaches": ["islam.creation.rainbow"], "say": { "ar": "هَيَّا نَتَعَرَّفُ عَلَى شَيْءٍ خَلَقَهُ اللهُ!", "en": "Let's meet something Allah created!" }, "focus": { "kind": "lex", "id": "rainbow" }, "meet": { "ar": "خَلَقَ اللهُ قَوْسَ قُزَحٍ؛ نَرَاهُ بَعْدَ الْمَطَرِ بِأَلْوَانِهِ الْجَمِيلَةِ.", "en": "Allah created the rainbow. We see its colors after the rain." }, "check": { "say": { "ar": "أَيْنَ قَوْسُ قُزَحٍ؟", "en": "Where is the rainbow?" }, "answer": { "kind": "lex", "id": "rainbow" }, "choices": [ { "kind": "lex", "id": "rainbow" }, { "kind": "lex", "id": "sea" } ] } }
