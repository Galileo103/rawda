            }
          }
        }
      ]
    },
    {
      "number": 109,
      "nameAr": "الكافرون",
      "nameTranslit": "Al-Kaafiroon",
      "nameEn": "The Disbelievers",
      "ayahCount": 6,
      "basmalaHeading": true,
      "ayahs": [
        {
          "n": 1,
          "text": "قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ",
          "audio": "quran/minshawy-muallim/109001.mp3",
          "sha256": "433f45be1ed7a03b98a726f7ae30ddbd57194edd87a9a85c9a6aa96d577829df",
          "more": {
            "husary-muallim": {
