            }
          }
        },
        {
          "n": 3,
          "text": "فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ",
          "audio": "quran/minshawy-muallim/106003.mp3",
          "sha256": "877da6adc4018c7b92567a9cab81eee028fdc76289f69979137ec881514c328e",
          "more": {
            "husary-muallim": {
              "audio": "quran/husary-muallim/106003.mp3",
              "sha256": "4161649bd2b206b4892fbc32485f6fbedd2e3688e6512a915a4c5f1d2a978b56"
            }
          }
        },
        {
          "n": 4,
          "text": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ",
          "audio": "quran/minshawy-muallim/106004.mp3",
          "sha256": "c8cfb2a7ba0277fb8aad679c4b84cfc727b9fc8cb3d8beca86178db4fad2592a",
          "more": {
            "husary-muallim": {
              "audio": "quran/husary-muallim/106004.mp3",
              "sha256": "6d1cc728ff975c74ad28a4879e4982c51235a52e43e14b92747ad995e2bc4e46"
            }
          }
        }
      ]
    },
    {
      "number": 105,
