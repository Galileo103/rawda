            }
          }
        },
        {
          "n": 3,
          "text": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
          "audio": "quran/minshawy-muallim/104003.mp3",
          "sha256": "8ea310cc28afa5461cc70a2f0ee68c8213a7a1a52f2e45f27ca6d55c869aac90",
          "more": {
            "husary-muallim": {
              "audio": "quran/husary-muallim/104003.mp3",
              "sha256": "6a8083bdee9aac78b6e0455c9aad34f9dede9bd14d5e870cc57fa52d4bf36a7d"
            }
          }
        },
        {
          "n": 4,
          "text": "كَلَّا لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ",
