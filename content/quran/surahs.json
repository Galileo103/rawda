            }
          }
        },
        {
          "n": 2,
          "text": "لَآ أَعْبُدُ مَا تَعْبُدُونَ",
          "audio": "quran/minshawy-muallim/109002.mp3",
          "sha256": "b6f3be273317bf85becacaa884d99e2d71e6a61654b77bd92891a67e8937fd3e",
