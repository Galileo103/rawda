            }
          }
        },
        {
          "n": 3,
          "text": "إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ",
          "audio": "quran/minshawy-muallim/108003.mp3",
          "sha256": "e66609da9e5c0ee6387e9cb253cb72dcfab2d23b17058ddc7a293f254f3a3faf",
          "more": {
            "husary-muallim": {
