      "nameTranslit": "Al-Fil",
      "nameEn": "The Elephant",
      "ayahCount": 5,
      "basmalaHeading": true,
      "ayahs": [
        {
          "n": 1,
          "text": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ",
          "audio": "quran/minshawy-muallim/105001.mp3",
          "sha256": "03f464a93054f36af0e97ff68361eaa5664bf96c8262e2890ce8ef788caf6a58",
          "more": {
            "husary-muallim": {
