            }
          }
        },
        {
          "n": 2,
          "text": "وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًا",
          "audio": "quran/minshawy-muallim/110002.mp3",
          "sha256": "0bb3bea380e6c5eceb9253120b7f13354f6da47fa04906eb862f86c20eec70f3",
