              "sha256": "18d079f18db093f2eab9d2040d3f65604f0af4c1974969eff560a0d90f5eecb5"
            }
          }
        },
        {
          "n": 3,
          "text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
          "audio": "quran/minshawy-muallim/107003.mp3",
          "sha256": "72c1927cb4575e1d99e4009d7dbdab031de618a0fbef719b627e08041f383187",
          "more": {
            "husary-muallim": {
              "audio": "quran/husary-muallim/107003.mp3",
              "sha256": "209ef3f4034969a36cc839aa202ee5b82cbcbcba6eb6682f2c00a33f3f19404e"
            }
          }
        },
        {
          "n": 4,
          "text": "فَوَيْلٌ لِّلْمُصَلِّينَ",
          "audio": "quran/minshawy-muallim/107004.mp3",
          "sha256": "01e008b315856323209bc5a2cd6b8097e1e28eabc31b9b66ca95e6087bf65823",
          "more": {
            "husary-muallim": {
