              "sha256": "33637fe3d96515cb8598583bdc12a88a7e6bde1944da586d1148e5e91f7abb3e"
            }
          }
        },
        {
          "n": 2,
          "text": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ",
          "audio": "quran/minshawy-muallim/107002.mp3",
          "sha256": "99a5275be282957997b8e80892dfa7f090a11f166aef0ad5c7c13ebc5f10ce9e",
