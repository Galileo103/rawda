            }
          }
        }
      ]
    },
    {
      "number": 107,
      "nameAr": "الماعون",
      "nameTranslit": "Al-Maa'un",
      "nameEn": "Almsgiving",
      "ayahCount": 7,
      "basmalaHeading": true,
      "ayahs": [
        {
          "n": 1,
          "text": "أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ",
          "audio": "quran/minshawy-muallim/107001.mp3",
