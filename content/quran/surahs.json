              "sha256": "92c9981d6e5838a3e1f5de1d7ba79a114bcc5b47780c5965d28d14714cae95f3"
            }
          }
        },
        {
          "n": 2,
          "text": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ",
          "audio": "quran/minshawy-muallim/105002.mp3",
          "sha256": "000675f175d59a65b492c7e9fc279b159d56f6f6b9b476ee724d791e7de99b84",
          "more": {
