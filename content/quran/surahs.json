              "sha256": "6ff1b36aad121869f406bd8dec7811e887ee93b6ae678630b99aaa4a30705d13"
            }
          }
        },
        {
          "n": 3,
          "text": "وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ",
          "audio": "quran/minshawy-muallim/105003.mp3",
          "sha256": "f191e4c526985158d7a4cd883ec507c44486b2d108fbd67c34bda69eb5d61172",
          "more": {
            "husary-muallim": {
              "audio": "quran/husary-muallim/105003.mp3",
              "sha256": "d9fa167256c9056c6ff86dc7516abbdd0d09a1e044fded310fc875e20b275964"
            }
          }
        },
        {
          "n": 4,
          "text": "تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ",
          "audio": "quran/minshawy-muallim/105004.mp3",
          "sha256": "18d3c967ebc7115447a701bdee0073d1dcfe3574f6ea6bd0975da00ad3089f77",
          "more": {
            "husary-muallim": {
              "audio": "quran/husary-muallim/105004.mp3",
              "sha256": "f5e717ba7687efa880c6302a8fdc093ad5e54d502dda642c1fea0d49e104cd41"
            }
          }
        },
        {
          "n": 5,
          "text": "فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ",
          "audio": "quran/minshawy-muallim/105005.mp3",
          "sha256": "b049a738d009d87065e431879c58895dbc90980bf93507964e3bf8fed6a803e2",
          "more": {
            "husary-muallim": {
              "audio": "quran/husary-muallim/105005.mp3",
              "sha256": "e5f7409b2ae5c3a22d342a04e2d590d9dc02cf5e9487712089cc1d3f371cff72"
            }
          }
        }
      ]
    },
    {
      "number": 104,
      "nameAr": "الهمزة",
      "nameTranslit": "Al-Humaza",
      "nameEn": "The Traducer",
      "ayahCount": 9,
      "basmalaHeading": true,
      "ayahs": [
