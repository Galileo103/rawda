            }
          }
        },
        {
          "n": 3,
          "text": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ",
          "audio": "quran/minshawy-muallim/109003.mp3",
          "sha256": "714bbac81d4b8fb84a2c3318b3d4115b0ead29f38774f20bf9565acb69c5dab2",
          "more": {
            "husary-muallim": {
              "audio": "quran/husary-muallim/109003.mp3",
              "sha256": "efc201ceb45512c58ccea603f50e973fa1ec5130361602634ab5672c03e6fd26"
            }
          }
        },
        {
          "n": 4,
          "text": "وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ",
          "audio": "quran/minshawy-muallim/109004.mp3",
          "sha256": "81177ce16d5951337e8a868dbe8efaa6299e3cafd00cd04514030f2ba5a1da24",
          "more": {
            "husary-muallim": {
              "audio": "quran/husary-muallim/109004.mp3",
              "sha256": "9f46d0a5d8f19af6e26c1fc960cdd6910afc0a1a2487f2f43e53162c2eb7a8f6"
            }
          }
        },
        {
          "n": 5,
          "text": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ",
          "audio": "quran/minshawy-muallim/109005.mp3",
          "sha256": "39699d2c2bfd65d8a3b4aee7398c857e364d6bd9bbcc85318249f686b0ec8ecf",
          "more": {
            "husary-muallim": {
              "audio": "quran/husary-muallim/109005.mp3",
              "sha256": "6b83d5a133b0403fe107c316424e3c360b1aadb872f11a689a401ef943a246df"
            }
          }
        },
        {
          "n": 6,
          "text": "لَكُمْ دِينُكُمْ وَلِىَ دِينِ",
          "audio": "quran/minshawy-muallim/109006.mp3",
          "sha256": "776fafde20286a8bae31e3be4538cb85ea6a82c0e845a02df0031c8b409b0a3d",
          "more": {
            "husary-muallim": {
              "audio": "quran/husary-muallim/109006.mp3",
              "sha256": "bfeb5386b3d23d1ffa99a32dec86dcb303f24a2ed58dc48951c0b6f7930c74dd"
            }
          }
        }
      ]
    },
    {
