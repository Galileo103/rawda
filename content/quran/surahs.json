              "sha256": "efef3f1cce041b0b95b752da811a5cd3ee3e963b361ca4796617b63b725013bc"
            }
          }
        },
        {
          "n": 2,
          "text": "ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ",
