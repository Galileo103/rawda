            }
          }
        },
        {
          "n": 5,
          "text": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ",
          "audio": "quran/minshawy-muallim/107005.mp3",
          "sha256": "60a128c00e47ab12248c89b8729099b1b88e1bf59e61fd06666c023107f6e370",
          "more": {
            "husary-muallim": {
              "audio": "quran/husary-muallim/107005.mp3",
              "sha256": "aeaacbdc51634d352a89a4bf39877c4d5ccc52deccdf52818c4a4f894ec71eaa"
            }
          }
        },
        {
          "n": 6,
          "text": "ٱلَّذِينَ هُمْ يُرَآءُونَ",
          "audio": "quran/minshawy-muallim/107006.mp3",
          "sha256": "dfea633402a979a38005f3a31fdf556d7979b91a6953e2fa6aab501a6181b820",
          "more": {
            "husary-muallim": {
              "audio": "quran/husary-muallim/107006.mp3",
              "sha256": "5ea230c06ec0a84c71d743f6768c1946a680f1904e4cc3b7bd0a5e2900884515"
            }
          }
        },
        {
          "n": 7,
          "text": "وَيَمْنَعُونَ ٱلْمَاعُونَ",
          "audio": "quran/minshawy-muallim/107007.mp3",
          "sha256": "71bc13b53cab063ecf14c22538bb13bd78d4fb824d25f137ac90081cf2989e89",
          "more": {
            "husary-muallim": {
              "audio": "quran/husary-muallim/107007.mp3",
