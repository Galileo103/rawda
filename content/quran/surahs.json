          "more": {
            "minshawy-muallim": {
              "audio": "quran/minshawy-muallim/001001.mp3",
              "sha256": "6a5181ddf39b8d6bd64ad9ed50bb74b2ae56729e6d11fdd7cdedd20a7b1520ad"
            }
          }
        },
        {
